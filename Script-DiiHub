local function clearDiiEffects()
    for _, v in ipairs(Lighting:GetChildren()) do
        if v.Name:match("^DiiUi_") then
            v:Destroy()
        end
    end
end

local function preset(name)
    clearDiiEffects()

    if name == "HD" then
        Lighting.Brightness = 3
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
    elseif name == "Low" then
        Lighting.Brightness = 1
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    elseif name == "Horror" then
        Lighting.Brightness = 0.5
        Lighting.ClockTime = 0
        Lighting.FogEnd = 100
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "DiiUi_Horror"
        cc.TintColor = Color3.fromRGB(180, 190, 210)
        cc.Contrast = 0.35
        cc.Saturation = -0.7
        cc.Parent = Lighting
    elseif name == "Sunset" then
        Lighting.ClockTime = 18
        Lighting.Brightness = 2
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "DiiUi_Sunset"
        cc.TintColor = Color3.fromRGB(255, 170, 110)
        cc.Parent = Lighting
    elseif name == "Night" then
        Lighting.ClockTime = 0
        Lighting.Brightness = 0.5
    elseif name == "Fog" then
        Lighting.FogEnd = 80
        Lighting.FogStart = 5
    elseif name == "Reset" then
        for k, v in pairs(oldLighting) do
            Lighting[k] = v
        end
        Lighting.FogStart = 0
    end
end

