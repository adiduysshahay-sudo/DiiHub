-- FREE CAM (CLIENT CAMERA ONLY)
--====================================
local freeCam = {Enabled=false, Speed=35, Sensitivity=0.22, FOV=70, Pitch=0, Yaw=0, CFrame=nil, SavedType=nil, SavedSubject=nil, SavedFOV=70, Rotating=false}
local freeCamConnection
local function startFreeCam()
    local cam = workspace.CurrentCamera
    if not cam then return end
    freeCam.SavedType = cam.CameraType
    freeCam.SavedSubject = cam.CameraSubject
    freeCam.SavedFOV = cam.FieldOfView
    freeCam.CFrame = cam.CFrame
    local pitch, yaw = cam.CFrame:ToOrientation()
    freeCam.Pitch, freeCam.Yaw = pitch, yaw
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = freeCam.FOV
    freeCam.Enabled = true
    if freeCamConnection then freeCamConnection:Disconnect() end
    freeCamConnection = RunService.RenderStepped:Connect(function(dt)
        if not freeCam.Enabled then return end
        cam = workspace.CurrentCamera
        if not cam then return end
        local move = Vector3.zero
        if not UIS:GetFocusedTextBox() then
            if UIS:IsKeyDown(Enum.KeyCode.W) then move += Vector3.new(0,0,-1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move += Vector3.new(0,0,1) end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move += Vector3.new(-1,0,0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move += Vector3.new(1,0,0) end
            if UIS:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.Q) then move += Vector3.new(0,-1,0) end
        end
        local rotation = CFrame.fromOrientation(freeCam.Pitch, freeCam.Yaw, 0)
        local speed = freeCam.Speed * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 0.35 or 1)
        local delta = rotation:VectorToWorldSpace(move)
        if delta.Magnitude > 0 then delta = delta.Unit end
        freeCam.CFrame = CFrame.new(freeCam.CFrame.Position + delta * speed * dt) * rotation
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = freeCam.CFrame
        cam.FieldOfView = freeCam.FOV
    end)
end
local function stopFreeCam()
    freeCam.Enabled = false
    freeCam.Rotating = false
    UIS.MouseBehavior = Enum.MouseBehavior.Default
    if freeCamConnection then freeCamConnection:Disconnect(); freeCamConnection=nil end
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = freeCam.SavedType or Enum.CameraType.Custom
        cam.CameraSubject = freeCam.SavedSubject
        cam.FieldOfView = freeCam.SavedFOV or 70
    end
end
UIS.InputBegan:Connect(function(input, processed)
    if freeCam.Enabled and input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
        freeCam.Rotating = true
        UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        freeCam.Rotating = false
        UIS.MouseBehavior = Enum.MouseBehavior.Default
    end
end)
UIS.InputChanged:Connect(function(input)
    if not freeCam.Enabled then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement and freeCam.Rotating then
        freeCam.Yaw = freeCam.Yaw - math.rad(input.Delta.X * freeCam.Sensitivity)
        freeCam.Pitch = math.clamp(freeCam.Pitch - math.rad(input.Delta.Y * freeCam.Sensitivity), -math.rad(89), math.rad(89))
    elseif input.UserInputType == Enum.UserInputType.MouseWheel then
        freeCam.FOV = math.clamp(freeCam.FOV - input.Position.Z * 4, 10, 120)
    end
end)
local function freeCamTab()
    clearContent()
    label("FREE CAM")
    label("WASD bergerak | Q/E turun-naik | tahan klik kanan untuk melihat")
    button(freeCam.Enabled and "Matikan Free Cam" or "Aktifkan Free Cam", function()
        if freeCam.Enabled then stopFreeCam() else startFreeCam() end
        freeCamTab()
    end)
    label("Kecepatan: " .. tostring(freeCam.Speed))
    local speedBox = textbox("Kecepatan kamera (1-150)")
    speedBox.Text = tostring(freeCam.Speed)
    button("Terapkan Kecepatan", function()
        local v = tonumber(speedBox.Text)
        if v then freeCam.Speed = math.clamp(v, 1, 150); freeCamTab() else notify("Angka tidak valid") end
    end)
    label("FOV: " .. tostring(freeCam.FOV))
    local fovBox = textbox("FOV (10-120)")
    fovBox.Text = tostring(freeCam.FOV)
    button("Terapkan FOV", function()
        local v = tonumber(fovBox.Text)
        if v then freeCam.FOV = math.clamp(v, 10, 120); if freeCam.Enabled and workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView=freeCam.FOV end; freeCamTab() else notify("Angka tidak valid") end
    end)
    button("Reset Kamera", function()
        freeCam.Speed=35; freeCam.FOV=70
        if freeCam.Enabled then stopFreeCam() end
        freeCamTab()
    end)
end

