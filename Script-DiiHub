-- NANA COIN HUTAN (READ-ONLY COIN PANEL)
-- Menampilkan saldo Coins yang direplikasi oleh game.
-- Tidak memanggil GiveCoinsEvent atau mengubah saldo server.
--====================================
local function nanaCoinTab()
    clearContent()
    label("NANA COIN HUTAN")
    label("Coin Balance - tampilan lokal/read-only")

    local balanceLabel = label("Coins: memuat...")
    local function refreshCoinBalance()
        local stats = LP:FindFirstChild("leaderstats")
        local coins = stats and (
            stats:FindFirstChild("Coins")
            or stats:FindFirstChild("Coin")
            or stats:FindFirstChild("Cash")
        )

        if coins and (coins:IsA("IntValue") or coins:IsA("NumberValue")) then
            balanceLabel.Text = "Coins: " .. tostring(coins.Value)
        else
            balanceLabel.Text = "Coins: tidak ditemukan"
        end
    end

    button("Refresh Coin Balance", refreshCoinBalance)
    label("Panel ini hanya membaca saldo yang tersedia di client.")
    label("Penambahan koin harus dilakukan oleh sistem resmi server game.")

    refreshCoinBalance()
end

