        {"Posisi Y (per 0.1 stud)", "Y", -50, 50}, {"Posisi Z (per 0.1 stud)", "Z", -50, 50},
        {"Rotasi X", "RX", -180, 180}, {"Rotasi Y", "RY", -180, 180}, {"Rotasi Z", "RZ", -180, 180},
    }
    for _, field in ipairs(fields) do
        label(field[1] .. " | sekarang: " .. tostring(cfg[field[2]]))
        local box = textbox("Masukkan angka")
        box.Text = tostring(cfg[field[2]])
        button("Terapkan " .. field[1], function()
            local value = tonumber(box.Text)
            if not value then notify("Masukkan angka yang valid") return end
            cfg[field[2]] = math.clamp(value, field[3], field[4])
            applyLimitedTransform(selectedLimited)
            notify(field[1] .. " diperbarui")
        end)
    end
    button("Efek: ON / OFF", function()
        cfg.Effects = not cfg.Effects
        applyLimitedTransform(selectedLimited)
        notify("Efek " .. (cfg.Effects and "ON" or "OFF"))
    end)
    button("Reset Transform", function()
        LimitedConfig[selectedLimited] = defaultLimitedConfig()
        if LimitedActive[selectedLimited] then
            LimitedActive[selectedLimited].Config = LimitedConfig[selectedLimited]
        end
        applyLimitedTransform(selectedLimited)
        limitedItemTab()
    end)
end

