        local idBox = textbox("Image Asset ID baru (angka / rbxassetid://...)")
        button("鉁�  Terapkan ke Target", function()
            if not Sign.Selected or not Sign.Selected.inst.Parent then
                toast("Pilih target papan dulu")
                return
            end
            local uri = toAssetUri(idBox.Text)
            if not uri then toast("Isi Image Asset ID yang valid dulu") return end
            local ok = applyImage(Sign.Selected, uri)
            if ok then
                toast("鉁� Gambar " .. Sign.Selected.name .. " diganti")
                signTab()
            else
                toast("Gagal mengganti (properti terkunci?)")
            end
        end)
        button("猸�  Simpan ID di atas sebagai Favorit", function()
            local uri = toAssetUri(idBox.Text)
            if not uri then toast("Isi Image Asset ID yang valid dulu") return end
            for _, f in ipairs(Sign.Favorites) do
                if f.uri == uri then toast("Sudah ada di favorit") return end
            end
            table.insert(Sign.Favorites, 1, {uri = uri, label = idBox.Text})
            toast("猸� Disimpan ke favorit")
            signTab()
        end)

        slider("Radius pencarian (stud)", 10, 300, Sign.Radius, 10, function(v)
            Sign.Radius = v
        end)

        -- FAVORIT
        if #Sign.Favorites > 0 then
            label("猸� FAVORIT  (tap = langsung terapkan ke target)")
            for i, fav in ipairs(Sign.Favorites) do
                imageCard({
                    preview = fav.uri,
                    title = fav.label,
                    subtitle = "tap untuk pakai di target",
                    onClick = function()
                        if not Sign.Selected or not Sign.Selected.inst.Parent then
                            toast("Pilih target papan dulu")
                            return
                        end
                        local ok = applyImage(Sign.Selected, fav.uri)
                        if ok then
                            toast("鉁� Diterapkan dari favorit")
                            signTab()
                        else
                            toast("Gagal mengganti (properti terkunci?)")
                        end
                    end,
                    onRemove = function()
                        table.remove(Sign.Favorites, i)
                        signTab()
                    end,
                })
            end
        end

        -- DAFTAR GAMBAR DI SEKITAR
        label("GAMBAR DI SEKITAR  (tap = pilih sebagai target)")
        local status = label("Memindai gambar di sekitar...")
        local found = scanSigns()
        if ActiveTab ~= signTab or not status.Parent then return end

        if #found == 0 then
            status.Text = "鉂� Tidak ada Decal/Texture/ImageLabel dalam radius ini.\n"
                .. "Perbesar radius di atas atau jalan mendekat ke papannya, lalu pindai ulang."
        else
            status.Text = string.format("鉁� Ditemukan %d gambar (terdekat di atas)", #found)
            for i, item in ipairs(found) do
                if i > 20 then break end
                local edited = Sign.Saved[item.inst] ~= nil
                local isSel = Sign.Selected and Sign.Selected.inst == item.inst
                imageCard({
                    preview = item.preview,
                    title = (edited and "鉁� " or "") .. item.name,
                    subtitle = string.format("%d stud%s", math.floor(item.dist),
                        isSel and "  鈥�  target sekarang" or ""),
                    selected = isSel,
                    onClick = function()
                        Sign.Selected = item
                        signTab()
                    end,
                })
            end
        end

        button("鈫�  Pindai ulang", function() signTab() end)
        button("鈫�  Kembalikan SEMUA ke gambar asli", function()
            local n = revertAll()
            toast(n > 0 and ("Dikembalikan " .. n .. " gambar") or "Belum ada yang diganti")
            signTab()
        end)

        label("Catatan: pakai Asset ID gambar milikmu sendiri (sudah di-upload "
            .. "ke akun Robloxmu sebagai Decal/Image) supaya tidak kena blokir "
            .. "moderasi konten. Favorit hanya tersimpan selama sesi/server ini "
            .. "berjalan (hilang kalau script dijalankan ulang). Beberapa "
            .. "Decal/Texture dikunci server dan tidak bisa diubah dari client 鈥� "
            .. "kalau gagal, biasanya itu sebabnya.")
    end
