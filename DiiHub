    signTab = function()
        clearContent()
        label("馃柤 GANTI GAMBAR PAPAN / SIGN")
        label("Hanya tampil di layarmu sendiri. Orang lain tetap lihat gambar asli.")

        -- status target yang sedang dipilih
        if Sign.Selected and Sign.Selected.inst.Parent then
