        if opts.onRemove then
            local rm = Instance.new("TextButton")
            rm.Size = UDim2.fromOffset(60, 34)
            rm.Position = UDim2.new(1, -68, 0.5, -17)
            rm.BackgroundColor3 = Color3.fromRGB(190, 50, 80)
            rm.Text = "鉁� Hapus"
