-- DiiUi HUB | LOADER (file "DiiHub" di GitHub)
-- Link lama tetap dipakai: loadstring(game:HttpGet(".../DiiHub?t="..os.time()))()
-- File ini kecil; script besarnya ada di file "DiiHub_Main".
-- Kalau ada yang gagal, alasannya muncul sebagai notifikasi di layar + console.

local USER, REPO, BRANCH, FILE = "adiduysshahay-sudo", "DiiHub", "main", "DiiHub_Main"
local stamp = tostring(os.time())

local SOURCES = {
    ("https://raw.githubusercontent.com/%s/%s/%s/%s?t=%s"):format(USER, REPO, BRANCH, FILE, stamp),
    ("https://cdn.jsdelivr.net/gh/%s/%s@%s/%s"):format(USER, REPO, BRANCH, FILE), -- cadangan kalau raw.githubusercontent diblokir
}

local function note(msg)
    warn("[DiiUi Loader] " .. tostring(msg))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "DiiUi HUB",
            Text = string.sub(tostring(msg), 1, 200),
            Duration = 15,
        })
    end)
end

local src, lastErr
for _, url in ipairs(SOURCES) do
    for attempt = 1, 2 do
        local ok, res = pcall(game.HttpGet, game, url)
        if ok and type(res) == "string" and #res > 1000 then
            src = res
            break
        end
        lastErr = ok and ("respon kosong/terlalu kecil dari " .. url) or tostring(res)
        task.wait(1)
    end
    if src then break end
end

if not src then
    return note("Gagal download script. Cek internet / coba ganti jaringan. (" .. tostring(lastErr) .. ")")
end

local fn, cerr = loadstring(src)
if not fn then
    return note("Executor gagal compile script: " .. tostring(cerr))
end

local ok, rerr = pcall(fn)
if not ok then
    note("Error saat menjalankan: " .. tostring(rerr))
end
