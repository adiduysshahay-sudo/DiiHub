    cone.Shape = Enum.PartType.Block
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxasset://fonts/cone.mesh" -- cone bawaan Roblox, tanpa perlu Asset ID luar
