local function lockCharacter(state)
    if state then
        CAS:BindActionAtPriority(FREECAM_ACTION, function()
            return Enum.ContextActionResult.Sink
        end, false, Enum.ContextActionPriority.High.Value, table.unpack(lockKeys))
