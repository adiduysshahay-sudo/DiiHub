-- MEME SOUNDBOARD (jendela sendiri, terpisah dari menu lain)
-- Buka/tutup: hotkey B, atau lewat tab "Meme Soundboard".
-- Suara diputar lokal di layarmu. Kalau "Bagikan" ON, 1 baris kode "[DUS] ..."
-- dikirim lewat chat; pengguna script ini lainnya menyembunyikan baris itu dan
-- memutar suaranya dari posisi kepalamu (3D). Pemain tanpa script TIDAK bisa
-- mendengarnya: suara buatan client tidak pernah sampai ke server.
--====================================
do
    local SoundService = game:GetService("SoundService")
    local TextChatService = game:GetService("TextChatService")
    local TAG = "[DUS] "
    local SB = {Volume = 70, Send = false, Hear = true, LastSend = 0, Heard = {}}
    local Playing = setmetatable({}, {__mode = "k"})
    Inv.SB = SB

    -- suara bawaan klien Roblox (indeks dipakai di Inv.SoundList -> Builtin)
    local BUILTIN = {
        {"Oof Klasik", "rbxasset://sounds/uuhhh.mp3"},
        {"Bass Drop", "rbxasset://sounds/bass.mp3"},
        {"Snap", "rbxasset://sounds/snap.mp3"},
        {"Victory", "rbxasset://sounds/victory.wav"},
        {"Kerplunk", "rbxasset://sounds/kerplunk.wav"},
        {"Splat", "rbxasset://sounds/splat.wav"},
        {"Tebas Pedang", "rbxasset://sounds/swordslash.wav"},
        {"Ping Elektronik", "rbxasset://sounds/electronicpingshort.wav"},
        {"Cipratan Air", "rbxasset://sounds/impact_water.mp3"},
    }

    local B36 = "0123456789abcdefghijklmnopqrstuvwxyz"
    local function toB36(n)
        n = math.floor(n)
        if n <= 0 then return "0" end
        local out = ""
        while n > 0 do
            local r = n % 36
            out = B36:sub(r + 1, r + 1) .. out
            n = (n - r) / 36
        end
        return out
    end
    local function fromB36(str)
        local n = 0
        for c in str:gmatch(".") do
            local i = B36:find(c, 1, true)
            if not i then return nil end
            n = n * 36 + (i - 1)
        end
        return n
    end

    local function playSound(soundId, vol, speed, parent, is3d, announceFail)
        local snd = Instance.new("Sound")
        snd.Name = "DiiUi_Sfx"
        snd.SoundId = soundId
        snd.Volume = vol
        snd.PlaybackSpeed = speed
        if is3d then
            snd.RollOffMode = Enum.RollOffMode.Linear
            snd.RollOffMinDistance = 10
            snd.RollOffMaxDistance = 90
        end
        snd.Parent = parent
        Playing[snd] = true
        snd.Ended:Connect(function() snd:Destroy() end)
        snd:Play()
        task.delay(3, function()
            if snd.Parent and not snd.IsLoaded then
                snd:Destroy()
                if announceFail then notify("Suara gagal dimuat (ID salah / tidak bisa diakses)") end
            end
        end)
        task.delay(25, function() if snd.Parent then snd:Destroy() end end)
        return snd
    end

    local function stopAll()
        for snd in pairs(Playing) do
            pcall(function() snd:Destroy() end)
        end
        table.clear(Playing)
    end

    local function sendText(text)
        pcall(function()
            local ch = TextChatService:FindFirstChild("TextChannels")
            local general = ch and ch:FindFirstChild("RBXGeneral")
            if general then
                general:SendAsync(text)
            else
                game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
            end
        end)
    end

    -- def = satu baris dari Inv.SoundList
    local function playDef(def)
        local sid, tag
        local id = tonumber(def.Id)
        if def.Builtin and BUILTIN[def.Builtin] then
            sid, tag = BUILTIN[def.Builtin][2], "b" .. def.Builtin
        elseif id and id > 0 then
            sid, tag = "rbxassetid://" .. math.floor(id), "a" .. toB36(id)
        else
            notify((def.Name or "Sound") .. ": Asset ID belum diisi (edit Inv.SoundList di kode)")
            return
        end
        playSound(sid, SB.Volume / 100 * 2, 1, SoundService, false, true)
        if SB.Send and os.clock() - SB.LastSend > 1.5 then
            SB.LastSend = os.clock()
            sendText(TAG .. tag .. "," .. math.floor(SB.Volume) .. ",100")
        end
    end

    ---------------- TERIMA dari pengguna script lain ----------------
    local function onText(text, plr)
        if not SB.Hear or not plr or plr == LP then return end
        if type(text) ~= "string" or text:sub(1, #TAG) ~= TAG then return end
        local now = os.clock()
        if SB.Heard[plr.UserId] and now - SB.Heard[plr.UserId] < 1.2 then return end
        SB.Heard[plr.UserId] = now
        local what, v, sp = text:sub(#TAG + 1):match("^(%w+),(%d+),(%d+)")
        if not what then return end
        local sid
        if what:sub(1, 1) == "b" then
            local bi = BUILTIN[tonumber(what:sub(2))]
            sid = bi and bi[2]
        elseif what:sub(1, 1) == "a" then
            local id = fromB36(what:sub(2))
            sid = id and id > 0 and ("rbxassetid://" .. id) or nil
        end
        local head = plr.Character and plr.Character:FindFirstChild("Head")
        if not (sid and head) then return end
        local vol = math.clamp((tonumber(v) or 70) / 100 * 2, 0, 1.5)   -- batas volume dari orang lain
        local speed = math.clamp((tonumber(sp) or 100) / 100, 0.5, 2)
        playSound(sid, vol, speed, head, true, false)
    end

    -- sembunyikan baris "[DUS] ..." dari chat milik pengguna script
    pcall(function()
        local old = TextChatService.OnIncomingMessage
        TextChatService.OnIncomingMessage = function(m)
            local props = old and old(m) or nil
            if type(m.Text) == "string" and m.Text:sub(1, #TAG) == TAG then
                props = props or Instance.new("TextChatMessageProperties")
                props.Text = ""
                props.PrefixText = ""
            end
            return props
        end
    end)
    pcall(function()
        TextChatService.MessageReceived:Connect(function(m)
            local src = m.TextSource
            if src then onText(m.Text, Players:GetPlayerByUserId(src.UserId)) end
        end)
    end)
    local function watch(plr)
        if plr == LP then return end
        plr.Chatted:Connect(function(msg) onText(msg, plr) end)
    end
    for _, pl in ipairs(Players:GetPlayers()) do watch(pl) end
    Players.PlayerAdded:Connect(watch)
    Players.PlayerRemoving:Connect(function(pl) SB.Heard[pl.UserId] = nil end)

